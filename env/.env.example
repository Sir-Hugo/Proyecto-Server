# Copia este archivo como .env y coloca los valores del tenant/API de desarrollo Auth0.
# No compartas ni subas el archivo .env real al repositorio.
Authentication__Authority=https://TU-TENANT.us.auth0.com/
Authentication__Audience=https://TU-IDENTIFICADOR-DE-API

# Required for the server since Phase 2B. Set externally; .NET does not load this file automatically.
# ConnectionStrings__GameDatabase=Host=localhost;Port=5433;Database=game;Username=game;Password=REPLACE_LOCALLY

# Optional resilience tuning (defaults shown).
# MatchLifecycle__RoundTimeoutMinutes=5
# MatchLifecycle__DisconnectGraceSeconds=30
# SignalR__KeepAliveSeconds=15
# SignalR__ClientTimeoutSeconds=45
