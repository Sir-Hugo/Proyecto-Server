{
  "Http": {
    "MaximumRequestBodyBytes": 65536
  },
  "RoomLifecycle": {
    "InactivityLimitMinutes": 5,
    "CleanupIntervalSeconds": 30
  },
  "MatchLifecycle": {
    "InactivityLimitMinutes": 5,
    "RoundTimeoutMinutes": 5,
    "DisconnectGraceSeconds": 30,
    "CheckIntervalSeconds": 5
  },
  "SignalR": {
    "KeepAliveSeconds": 15,
    "ClientTimeoutSeconds": 45
  },
  "RateLimiting": {
    "Api": {
      "AuthenticatedPermitLimit": 120,
      "AnonymousPermitLimit": 30,
      "WindowSeconds": 60
    },
    "Hub": {
      "TransportPermitLimit": 240,
      "TransportWindowSeconds": 60,
      "InvocationPermitLimit": 60,
      "InvocationWindowSeconds": 10,
      "MaximumConnectionsPerUser": 5
    }
  },
  "Matchmaking": {
    "MaximumWaitMinutes": 4
  }
}
